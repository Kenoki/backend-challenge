# Puerto HTTP de la API (por defecto 3000)
# PORT=3000

# Cadena de conexion a Postgres (obligatoria). Si la base indicada (aqui clinicsay)
# no existe, el servicio la crea al arrancar.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinicsay

# URL base del proveedor externo de notificaciones
# PROVIDER_URL=http://localhost:4010

# "test" habilita el reloj controlable (PUT /test/clock); omitir en produccion
# CLOCK_MODE=test

# Nivel de logs de pino: trace, debug, info, warn, error, fatal (por defecto info)
# LOG_LEVEL=info
